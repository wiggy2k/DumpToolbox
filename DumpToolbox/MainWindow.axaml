<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DumpToolbox.MainWindow" Title="DumpToolbox" Width="1060" Height="780" MinWidth="800" MinHeight="620">
  <TabControl x:Name="MainTabControl" Margin="12">
    <TabItem>
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,10.79 15.62,12 14.97,13L21,19.03L19.03,21L13,14.97C12,15.62 10.79,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z"/><TextBlock Text="FindCRCs" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto,190" RowSpacing="6">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="Image / source file" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="FilePathBox" Grid.Column="0" Watermark="Choose the large file to search..."/>
            <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
          <TextBlock Text="Optional CUE sheet" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="FindCrcsCueBox" Grid.Column="0" Watermark="Optional: choose the disc CUE for full audio-track mapping / Track 02 pregap fixes..."/>
            <Button x:Name="FindCrcsCueBrowseButton" Grid.Column="1" Click="FindCrcsCueBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            <Button x:Name="FindCrcsCueClearButton" Grid.Column="2" Content="Clear" Click="FindCrcsCueClearButton_Click"/>
          </Grid>
          <TextBlock x:Name="FindCrcsCueStatus" Text="No CUE selected — two-target singleton edge/silence recovery is available; pregap correction is CUE-only." Opacity="0.65" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Hash targets" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="TargetsClearButton" Grid.Column="1" Content="Clear" Click="TargetsClearButton_Click"/>
        </Grid>

        <TextBox x:Name="TargetsBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Watermark="Paste redump.info/disc/118856, just 118856, Redump rows, or: 19947312    b2c1da27    41ca00ff63fcc24e8b956cf6106dfe5e"/>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="StartButton" Grid.Column="0" Content="Search" Click="StartButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelButton_Click" IsEnabled="False"/>
            <Button x:Name="FindCrcsClearSavedInputsButton" Grid.Column="3" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="5">
            <WrapPanel Orientation="Horizontal">
              <CheckBox x:Name="FindCrcsEdgeRepairCheckBox" Content="Attempt to fix under-dumped Audio edges" IsChecked="False" IsEnabled="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
              <CheckBox x:Name="FindCrcsPregapScrambleCheckBox" Content="Scramble Track 2 pregap data sectors if present" IsChecked="False" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,18,0"/>
              <CheckBox x:Name="FindCrcsSavePartialCheckBox" Content="Save partial files for manual inspection" IsChecked="False" IsEnabled="True" VerticalAlignment="Center"/>
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="ProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="LogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M9,4 V15.5 C8.3,15.2 7.5,15 6.7,15 C4.7,15 3,16.1 3,17.5 C3,18.9 4.7,20 6.7,20 C8.7,20 10,18.9 10,17.5 V8 L18,6 V13.5 C17.3,13.2 16.5,13 15.7,13 C13.7,13 12,14.1 12,15.5 C12,16.9 13.7,18 15.7,18 C17.7,18 19,16.9 19,15.5 V3 Z"/><TextBlock Text="Audio" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,150,Auto,Auto,*,Auto,150" RowSpacing="8">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="Audio / raw PCM sources" FontWeight="SemiBold"/>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="AudioAddButton" Content="Add audio / image..." Click="AudioAddButton_Click" Margin="0,0,6,6"/>
            <Button x:Name="AudioPlaylistButton" Content="Add playlist..." Click="AudioPlaylistButton_Click" Margin="0,0,6,6"/>
            <Button x:Name="AudioRemoveButton" Content="Remove" Click="AudioRemoveButton_Click" Margin="0,0,6,6"/>
            <Button x:Name="AudioUpButton" Content="Move up" Click="AudioUpButton_Click" Margin="0,0,6,6"/>
            <Button x:Name="AudioDownButton" Content="Move down" Click="AudioDownButton_Click" Margin="0,0,6,6"/>
            <Button x:Name="AudioClearButton" Content="Clear" Click="AudioClearButton_Click" Margin="0,0,0,6"/>
          </WrapPanel>
        </StackPanel>

        <ListBox x:Name="AudioFilesList" Grid.Row="1" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="16">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock Text="Output / working folder" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="AudioOutputFolderBox" Grid.Column="0" Watermark="Converted CDDA BINs, combined working stream and recovered Redump tracks are written here..."/>
              <Button x:Name="AudioOutputBrowseButton" Grid.Column="1" Click="AudioOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Edge silence search (seconds)" FontWeight="SemiBold"/>
            <TextBox x:Name="AudioEdgeSecondsBox" Text="5" Watermark="5"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Redump audio-track hashes" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="AudioHashClearButton" Grid.Column="1" Content="Clear hashes" Click="AudioHashClearButton_Click"/>
        </Grid>

        <TextBox x:Name="AudioTargetsBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Watermark="Paste Redump disc URL / ID or audio rows here..."/>

        <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="AudioRecoverButton" Grid.Column="0" Content="Convert + recover" Click="AudioRecoverButton_Click"/>
            <Button x:Name="AudioCancelButton" Grid.Column="1" Content="Cancel" Click="AudioCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="AudioClearSavedInputsButton" Grid.Column="3" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <CheckBox x:Name="AudioEdgeRepairCheckBox" Content="Attempt to fix under-dumped segments with FindCRCs" IsChecked="False" VerticalAlignment="Center" Margin="0,0,18,6"/>
            <CheckBox x:Name="AudioSavePartialCheckBox" Content="Save partial edge tracks" IsChecked="False" VerticalAlignment="Center" Margin="0,0,18,6"/>
            <CheckBox x:Name="AudioHeadsTailsCheckBox" Content="Heads and Tails mode" IsChecked="False" IsVisible="False" VerticalAlignment="Center" Margin="0,0,18,6"/>
            <CheckBox x:Name="AudioDeleteTempCheckBox" Content="Delete working files" IsChecked="False" VerticalAlignment="Center" Margin="0,0,0,6"/>
          </WrapPanel>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="AudioProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="AudioProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="6" RowDefinitions="Auto,*" RowSpacing="5">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Activity log" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="AudioActivityLogButton" Grid.Column="1" Click="AudioActivityLogButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M12,5 C6.5,5 2.1,10 1,12 C2.1,14 6.5,19 12,19 C17.5,19 21.9,14 23,12 C21.9,10 17.5,5 12,5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z"/><TextBlock x:Name="AudioActivityLogButtonText" Text="Hide"/></StackPanel></Button>
            <Button x:Name="AudioLogDockButton" Grid.Column="2" Click="AudioLogDockButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M14,3 H21 V10 H19 V6.4 L11.7,13.7 L10.3,12.3 L17.6,5 H14 Z M5,5 H11 V7 H5 V19 H17 V13 H19 V19 C19,20.1 18.1,21 17,21 H5 C3.9,21 3,20.1 3,19 V7 C3,5.9 3.9,5 5,5 Z"/><TextBlock x:Name="AudioLogDockButtonText" Text="Undock"/></StackPanel></Button>
          </Grid>
          <Border x:Name="AudioLogPane" Grid.Row="1">
            <TextBox x:Name="AudioLogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
          </Border>
        </Grid>
      </Grid>
    </TabItem>


    <TabItem x:Name="ConvertTabItem">
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M7,4 L4,7 L7,10 V8 H15 C17.2,8 19,9.8 19,12 C19,12.7 18.8,13.4 18.5,14 L20,15 C20.6,14.1 21,13.1 21,12 C21,8.7 18.3,6 15,6 H7 Z M17,14 V16 H9 C6.8,16 5,14.2 5,12 C5,11.3 5.2,10.6 5.5,10 L4,9 C3.4,9.9 3,10.9 3,12 C3,15.3 5.7,18 9,18 H17 V20 L20,17 Z"/><TextBlock Text="Convert" VerticalAlignment="Center"/></StackPanel></TabItem.Header><TabControl x:Name="ConvertTabControl" Margin="8"><TabItem Header="ISO2BIN">
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
        <StackPanel Grid.Row="0" Spacing="5">
          <TextBlock Text="Input image (ISO-only; ignored when a CUE is supplied)" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="IsoInputBox" Grid.Column="0" Watermark="Choose a cooked 2048-byte ISO/BIN when not using a CUE..."/>
            <Button x:Name="IsoInputBrowseButton" Grid.Column="1" Click="IsoInputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="5">
          <TextBlock Text="Optional CUE (single- or multi-file mixed-mode layout)" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="IsoCueBox" Grid.Column="0" Watermark="Supports ISO+WAV, ISO+RAW/BIN, or mixed tracks in one file..."/>
            <Button x:Name="IsoCueBrowseButton" Grid.Column="1" Click="IsoCueBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            <Button x:Name="IsoCueClearButton" Grid.Column="2" Content="Clear" Click="IsoCueClearButton_Click"/>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5">
          <TextBlock Text="Optional XA metadata" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="IsoXaMetadataBox" Grid.Column="0" Watermark="Use original Mode 2 XA subheaders instead of generic 00 00 08 00..."/>
            <Button x:Name="IsoXaMetadataBrowseButton" Grid.Column="1" Click="IsoXaMetadataBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            <Button x:Name="IsoXaMetadataClearButton" Grid.Column="2" Content="Clear" Click="IsoXaMetadataClearButton_Click"/>
          </Grid>
          <TextBlock x:Name="IsoXaMetadataStatus" Text="No XA metadata selected." Opacity="0.65" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="5">
          <TextBlock Text="Optional Redump target" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="IsoTargetBox" Grid.Column="0" Watermark="Paste one Redump target row, Redump disc URL, or disc ID..."/>
            <Button x:Name="IsoTargetClearButton" Grid.Column="1" Content="Clear" Click="IsoTargetClearButton_Click"/>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="5">
          <TextBlock Text="Output BIN (2352 bytes/sector)" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="IsoOutputBox" Grid.Column="0" Watermark="Choose the raw .bin output file..."/>
            <Button x:Name="IsoOutputBrowseButton" Grid.Column="1" Click="IsoOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
          </Grid>
        </StackPanel>

        <Grid Grid.Row="5" ColumnDefinitions="300,*" ColumnSpacing="16">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock Text="ISO-only sector mode" FontWeight="SemiBold"/>
            <ComboBox x:Name="IsoModeBox" SelectedIndex="0">
              <ComboBoxItem Content="Auto detect (XA marker; otherwise Mode 1)"/>
              <ComboBoxItem Content="Mode 1"/>
              <ComboBoxItem Content="Mode 2 Form 1 (XA)"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Input check / detection" FontWeight="SemiBold"/>
            <TextBlock x:Name="IsoInspectionText" Text="No input selected." Opacity="0.75" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" Text="Conversion details" Opacity="0.7" FontSize="12"/>

        <Grid Grid.Row="7" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="IsoConvertButton" Grid.Column="0" Content="Convert" Click="IsoConvertButton_Click"/>
            <Button x:Name="IsoCancelButton" Grid.Column="1" Content="Cancel" Click="IsoCancelButton_Click" IsEnabled="False"/>
            <CheckBox x:Name="IsoSendToFindCrcsCheckBox" Grid.Column="2" Content="Use resulting BIN as FindCRCs source" IsChecked="False" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button x:Name="IsoClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="IsoProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="IsoProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="8" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="IsoLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="MDF2BIN">
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,190" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="MDS descriptor" FontWeight="SemiBold"/>
          <TextBox x:Name="Mdf2BinMdsBox" Grid.Column="1" Watermark="Choose the Alcohol .mds descriptor..."/>
          <Button x:Name="Mdf2BinMdsBrowseButton" Grid.Column="2" Click="Mdf2BinMdsBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="MDF data file" FontWeight="SemiBold"/>
          <TextBox x:Name="Mdf2BinMdfBox" Grid.Column="1" Watermark="Auto-detected from the MDS footer or matching filename..."/>
          <Button x:Name="Mdf2BinMdfBrowseButton" Grid.Column="2" Click="Mdf2BinMdfBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
          <Button x:Name="Mdf2BinMdfAutoButton" Grid.Column="3" Content="Auto" MinWidth="64" Click="Mdf2BinMdfAutoButton_Click"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Output BIN" FontWeight="SemiBold"/>
          <TextBox x:Name="Mdf2BinOutputBinBox" Grid.Column="1" Watermark="Raw 2352-byte BIN output..."/>
          <Button x:Name="Mdf2BinOutputBinBrowseButton" Grid.Column="2" Click="Mdf2BinOutputBinBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Output CUE" FontWeight="SemiBold"/>
          <TextBox x:Name="Mdf2BinOutputCueBox" Grid.Column="1" Watermark="Generated CUE sheet..."/>
          <Button x:Name="Mdf2BinOutputCueBrowseButton" Grid.Column="2" Click="Mdf2BinOutputCueBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
          <CheckBox x:Name="Mdf2BinSaveSubCheckBox" Grid.Column="0" Content="Also save 96-byte interleaved subchannel as .sub" IsChecked="False" VerticalAlignment="Center"/>
          <CheckBox x:Name="Mdf2BinSendToFindCrcsCheckBox" Grid.Column="1" Content="Use resulting BIN as FindCRCs source" IsChecked="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Border Grid.Row="5" BorderBrush="#666666" BorderThickness="1" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="Mdf2BinInspectionText" Text="No MDS analysed." FontFamily="monospace" TextWrapping="NoWrap"/>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="6" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="Mdf2BinAnalyzeButton" Grid.Column="0" Content="Analyse" Click="Mdf2BinAnalyzeButton_Click"/>
            <Button x:Name="Mdf2BinConvertButton" Grid.Column="1" Content="Convert" Click="Mdf2BinConvertButton_Click"/>
            <Button x:Name="Mdf2BinCancelButton" Grid.Column="2" Content="Cancel" Click="Mdf2BinCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="Mdf2BinClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="Mdf2BinProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="Mdf2BinProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="170" MaxWidth="280" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="7" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="Mdf2BinLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="NRG2BIN">
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,190" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="NRG image" FontWeight="SemiBold"/>
          <TextBox x:Name="Nrg2BinInputBox" Grid.Column="1" Watermark="Choose a Nero .nrg disc image..."/>
          <Button x:Name="Nrg2BinInputBrowseButton" Grid.Column="2" Click="Nrg2BinInputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Nrg2BinOutputImageLabel" Grid.Column="0" VerticalAlignment="Center" Text="Output image" FontWeight="SemiBold"/>
          <TextBox x:Name="Nrg2BinOutputBinBox" Grid.Column="1" Watermark="BIN for CD / ISO for DVD..."/>
          <Button x:Name="Nrg2BinOutputBinBrowseButton" Grid.Column="2" Click="Nrg2BinOutputBinBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Nrg2BinOutputCueLabel" Grid.Column="0" VerticalAlignment="Center" Text="Output CUE" FontWeight="SemiBold"/>
          <TextBox x:Name="Nrg2BinOutputCueBox" Grid.Column="1" Watermark="Generated CUE sheet..."/>
          <Button x:Name="Nrg2BinOutputCueBrowseButton" Grid.Column="2" Click="Nrg2BinOutputCueBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
          <CheckBox x:Name="Nrg2BinSaveSubCheckBox" Grid.Column="0" Content="Also save 96-byte subchannel as .sub" IsChecked="False" VerticalAlignment="Center"/>
          <CheckBox x:Name="Nrg2BinSendToFindCrcsCheckBox" Grid.Column="1" Content="Use resulting BIN as FindCRCs source" IsChecked="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Border Grid.Row="4" BorderBrush="#666666" BorderThickness="1" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="Nrg2BinInspectionText" Text="No NRG analysed." FontFamily="monospace" TextWrapping="NoWrap"/>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="Nrg2BinAnalyzeButton" Grid.Column="0" Content="Analyse" Click="Nrg2BinAnalyzeButton_Click"/>
            <Button x:Name="Nrg2BinConvertButton" Grid.Column="1" Content="Convert" Click="Nrg2BinConvertButton_Click"/>
            <Button x:Name="Nrg2BinCancelButton" Grid.Column="2" Content="Cancel" Click="Nrg2BinCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="Nrg2BinClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="Nrg2BinProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="Nrg2BinProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="170" MaxWidth="280" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="6" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="Nrg2BinLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="CDI2BIN">
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,190" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="CDI image" FontWeight="SemiBold"/>
          <TextBox x:Name="Cdi2BinInputBox" Grid.Column="1" Watermark="Choose a DiscJuggler .cdi disc image..."/>
          <Button x:Name="Cdi2BinInputBrowseButton" Grid.Column="2" Click="Cdi2BinInputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Cdi2BinOutputImageLabel" Grid.Column="0" VerticalAlignment="Center" Text="Output image" FontWeight="SemiBold"/>
          <TextBox x:Name="Cdi2BinOutputBinBox" Grid.Column="1" Watermark="BIN for CD / ISO for DVD..."/>
          <Button x:Name="Cdi2BinOutputBinBrowseButton" Grid.Column="2" Click="Cdi2BinOutputBinBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Cdi2BinOutputCueLabel" Grid.Column="0" VerticalAlignment="Center" Text="Output CUE" FontWeight="SemiBold"/>
          <TextBox x:Name="Cdi2BinOutputCueBox" Grid.Column="1" Watermark="Generated CUE sheet..."/>
          <Button x:Name="Cdi2BinOutputCueBrowseButton" Grid.Column="2" Click="Cdi2BinOutputCueBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
          <CheckBox x:Name="Cdi2BinSaveSubCheckBox" Grid.Column="0" Content="Also save 96-byte subchannel as .sub" IsChecked="False" VerticalAlignment="Center"/>
          <CheckBox x:Name="Cdi2BinSendToFindCrcsCheckBox" Grid.Column="1" Content="Use resulting BIN as FindCRCs source" IsChecked="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Border Grid.Row="4" BorderBrush="#666666" BorderThickness="1" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="Cdi2BinInspectionText" Text="No CDI analysed." FontFamily="monospace" TextWrapping="NoWrap"/>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="Cdi2BinAnalyzeButton" Grid.Column="0" Content="Analyse" Click="Cdi2BinAnalyzeButton_Click"/>
            <Button x:Name="Cdi2BinConvertButton" Grid.Column="1" Content="Convert" Click="Cdi2BinConvertButton_Click"/>
            <Button x:Name="Cdi2BinCancelButton" Grid.Column="2" Content="Cancel" Click="Cdi2BinCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="Cdi2BinClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="Cdi2BinProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="Cdi2BinProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="170" MaxWidth="280" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="6" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="Cdi2BinLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>

    </TabControl></TabItem><TabItem>
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M12,2 C6.5,2 3,5.6 3,10 C3,12.8 4.5,15.1 7,16.3 V20 H10 V18 H14 V20 H17 V16.3 C19.5,15.1 21,12.8 21,10 C21,5.6 17.5,2 12,2 Z M8.5,9 C9.3,9 10,9.7 10,10.5 C10,11.3 9.3,12 8.5,12 C7.7,12 7,11.3 7,10.5 C7,9.7 7.7,9 8.5,9 Z M15.5,9 C16.3,9 17,9.7 17,10.5 C17,11.3 16.3,12 15.5,12 C14.7,12 14,11.3 14,10.5 C14,9.7 14.7,9 15.5,9 Z M10,14 H14 L12,16 Z"/><TextBlock Text="SkeleTool" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <!-- Keep all four selectors in one grid so labels, text boxes and Browse buttons
             share exactly the same columns. -->
        <Grid Grid.Row="0" ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Redumper skeleton" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SkeletonPathBox" Grid.Row="0" Grid.Column="1" Watermark="Choose the .skeleton file..."/>
          <Button x:Name="SkeletonBrowseButton" Grid.Row="0" Grid.Column="2" Click="SkeletonBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Redumper hash manifest" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SkeletonHashBox" Grid.Row="1" Grid.Column="1" Watermark="Choose the matching .hash file..."/>
          <Button x:Name="SkeletonHashBrowseButton" Grid.Row="1" Grid.Column="2" Click="SkeletonHashBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Source files folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SkeletonSourceFolderBox" Grid.Row="2" Grid.Column="1" Watermark="Folder containing candidate extracted files..."/>
          <Button x:Name="SkeletonSourceBrowseButton" Grid.Row="2" Grid.Column="2" Click="SkeletonSourceBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Source ISO / BIN" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SkeletonSourceImageBox" Grid.Row="3" Grid.Column="1" Watermark="Optional ISO/BIN containing source files..."/>
          <Button x:Name="SkeletonSourceImageBrowseButton" Grid.Row="3" Grid.Column="2" Click="SkeletonSourceImageBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Resurrected output image" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="SkeletonOutputBox" Grid.Row="4" Grid.Column="1" Watermark="Output .bin/.iso (the original skeleton is never modified)..."/>
          <Button x:Name="SkeletonOutputBrowseButton" Grid.Row="4" Grid.Column="2" Click="SkeletonOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="14">
          <Button x:Name="SkeletonLoadButton" Grid.Column="0" Content="Load skeleton" Click="SkeletonLoadButton_Click"/>
          <CheckBox x:Name="SkeletonRecursiveCheckBox" Grid.Column="1" Content="Search subfolders" IsChecked="True" VerticalAlignment="Center"/>
          <CheckBox x:Name="SkeletonAllowMissingCheckBox" Grid.Column="2" Content="Allow missing files" IsChecked="False" VerticalAlignment="Center"/>
          <CheckBox x:Name="SkeletonForceRehashCheckBox" Grid.Column="3" IsChecked="False" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M17.7,6.3 C16.2,4.9 14.2,4 12,4 C7.6,4 4,7.6 4,12 C4,16.4 7.6,20 12,20 C15.7,20 18.8,17.5 19.7,14 H17.6 C16.8,16.3 14.6,18 12,18 C8.7,18 6,15.3 6,12 C6,8.7 8.7,6 12,6 C13.7,6 15.2,6.7 16.3,7.7 L13,11 H21 V3 Z"/><TextBlock Text="Force rehash (ignore cache)"/></StackPanel></CheckBox>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="SkeletonScanButton" Grid.Column="0" Content="Scan source folder" Click="SkeletonScanButton_Click" IsEnabled="False"/>
            <Button x:Name="SkeletonScanImageButton" Grid.Column="1" Content="Scan source ISO/BIN" Click="SkeletonScanImageButton_Click" IsEnabled="False"/>
            <Button x:Name="SkeletonCheckSha1DbButton" Grid.Column="2" Content="Check SHA-1 DB" Click="SkeletonCheckSha1DbButton_Click" IsEnabled="False"/>
            <Button x:Name="SkeletonResurrectButton" Grid.Column="3" Content="Resurrect" Click="SkeletonResurrectButton_Click" IsEnabled="False"/>
            <Button x:Name="SkeletonCancelButton" Grid.Column="4" Content="Cancel" Click="SkeletonCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="SkeletonClearSavedInputsButton" Grid.Column="6" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="SkeletonProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="SkeletonProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="285" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <TextBlock x:Name="SkeletonInspectionText" Grid.Row="3" Text="No skeleton loaded." Opacity="0.75" TextWrapping="Wrap"/>

        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="5">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="ISO contents / match status" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="Activity log" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="SkeletonActivityLogButton" Grid.Column="2" Click="SkeletonActivityLogButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M12,5 C6.5,5 2.1,10 1,12 C2.1,14 6.5,19 12,19 C17.5,19 21.9,14 23,12 C21.9,10 17.5,5 12,5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z"/><TextBlock x:Name="SkeletonActivityLogButtonText" Text="Hide"/></StackPanel></Button>
            <Button x:Name="SkeletonLogDockButton" Grid.Column="3" Click="SkeletonLogDockButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M14,3 H21 V10 H19 V6.4 L11.7,13.7 L10.3,12.3 L17.6,5 H14 Z M5,5 H11 V7 H5 V19 H17 V13 H19 V19 C19,20.1 18.1,21 17,21 H5 C3.9,21 3,20.1 3,19 V7 C3,5.9 3.9,5 5,5 Z"/><TextBlock x:Name="SkeletonLogDockButtonText" Text="Undock"/></StackPanel></Button>
          </Grid>

          <Grid x:Name="SkeletonWorkspaceGrid" Grid.Row="1" ColumnDefinitions="*,6,*">
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#666666" Padding="4" Margin="0,0,5,0">
                <TreeView x:Name="SkeletonTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontFamily="monospace"/>
                        <TextBlock Text=" " FontFamily="monospace" IsVisible="{Binding !IsFolder}"/>
                        <TextBlock Text="{Binding DetailsText}" FontFamily="monospace"/>
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter x:Name="SkeletonLogSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <Grid x:Name="SkeletonLogPane" Grid.Column="2" Margin="5,0,0,0">
              <Border Classes="activity-log-surface" BorderThickness="1" BorderBrush="#666666" CornerRadius="3">
                <ScrollViewer x:Name="SkeletonLogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="SkeletonLogPanel" Margin="4"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <TextBlock Grid.Row="5" Text="Resurrection details" Opacity="0.65" FontSize="11"/>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,11 A1,1 0 1 0 12,13 A1,1 0 1 0 12,11"/><TextBlock Text="DIC" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="DiscImageCreator log folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="DicLogPathBox" Grid.Row="0" Grid.Column="1" Watermark="Choose the folder containing the DiscImageCreator log set..."/>
          <Button x:Name="DicLogBrowseButton" Grid.Row="0" Grid.Column="2" Click="DicLogBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Source files folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="DicSourceFolderBox" Grid.Row="1" Grid.Column="1" Watermark="Optional folder of recovered files; all subfolders are searched..."/>
          <Button x:Name="DicSourceBrowseButton" Grid.Row="1" Grid.Column="2" Click="DicSourceBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Donor ISO / BIN" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="DicDonorImageBox" Grid.Row="2" Grid.Column="1" Watermark="Optional 2048-byte ISO or 2352-byte BIN donor (required only for unavailable raw ISO regions)..."/>
          <Button x:Name="DicDonorBrowseButton" Grid.Row="2" Grid.Column="2" Click="DicDonorBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Rebuilt output image" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="DicOutputBox" Grid.Row="3" Grid.Column="1" Watermark="Output raw 2352-byte .bin image..."/>
          <Button x:Name="DicOutputBrowseButton" Grid.Row="3" Grid.Column="2" Click="DicOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="14">
          <Button x:Name="DicLoadButton" Grid.Column="0" Content="Load DIC logs" Click="DicLoadButton_Click"/>
          <Button x:Name="DicClearStateButton" Grid.Column="1" Content="Clear saved matches" Click="DicClearStateButton_Click" IsEnabled="False"/>
          <CheckBox x:Name="DicAllowMissingCheckBox" Grid.Column="2" Content="Allow missing files" IsChecked="False" VerticalAlignment="Center"/>
          <CheckBox x:Name="DicForceRehashCheckBox" Grid.Column="3" IsChecked="False" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M17.7,6.3 C16.2,4.9 14.2,4 12,4 C7.6,4 4,7.6 4,12 C4,16.4 7.6,20 12,20 C15.7,20 18.8,17.5 19.7,14 H17.6 C16.8,16.3 14.6,18 12,18 C8.7,18 6,15.3 6,12 C6,8.7 8.7,6 12,6 C13.7,6 15.2,6.7 16.3,7.7 L13,11 H21 V3 Z"/><TextBlock Text="Force rehash / clear cache"/></StackPanel></CheckBox>
          <Button x:Name="DicClearSavedInputsButton" Grid.Column="5" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
            <Button x:Name="DicMatchButton" Grid.Column="0" Content="Scan source folder" Click="DicMatchButton_Click" IsEnabled="False"/>
            <Button x:Name="DicDonorScanButton" Grid.Column="1" Content="Scan donor image" Click="DicDonorScanButton_Click" IsEnabled="False"/>
            <Button x:Name="DicResurrectButton" Grid.Column="2" Content="Rebuild BIN" Click="DicResurrectButton_Click" IsEnabled="False"/>
            <Button x:Name="DicCancelButton" Grid.Column="3" Content="Cancel" Click="DicCancelButton_Click" IsEnabled="False"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="DicProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="DicProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="285" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <TextBlock x:Name="DicInspectionText" Grid.Row="3" Text="No DIC logs loaded." Opacity="0.75" TextWrapping="Wrap"/>

        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="5">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="DIC filesystem / match status" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="Activity log" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <CheckBox x:Name="DicVerboseLoggingCheckBox" Grid.Column="2" Content="Verbose" IsChecked="False" VerticalAlignment="Center"/>
            <Button x:Name="DicActivityLogButton" Grid.Column="3" Click="DicActivityLogButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M12,5 C6.5,5 2.1,10 1,12 C2.1,14 6.5,19 12,19 C17.5,19 21.9,14 23,12 C21.9,10 17.5,5 12,5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z"/><TextBlock x:Name="DicActivityLogButtonText" Text="Hide"/></StackPanel></Button>
            <Button x:Name="DicLogDockButton" Grid.Column="4" Click="DicLogDockButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M14,3 H21 V10 H19 V6.4 L11.7,13.7 L10.3,12.3 L17.6,5 H14 Z M5,5 H11 V7 H5 V19 H17 V13 H19 V19 C19,20.1 18.1,21 17,21 H5 C3.9,21 3,20.1 3,19 V7 C3,5.9 3.9,5 5,5 Z"/><TextBlock x:Name="DicLogDockButtonText" Text="Undock"/></StackPanel></Button>
          </Grid>

          <Grid x:Name="DicWorkspaceGrid" Grid.Row="1" ColumnDefinitions="*,6,*">
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#666666" Padding="4" Margin="0,0,5,0">
                <TreeView x:Name="DicTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontFamily="monospace"/>
                        <TextBlock Text=" " FontFamily="monospace" IsVisible="{Binding !IsFolder}"/>
                        <TextBlock Text="{Binding DetailsText}" FontFamily="monospace"/>
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter x:Name="DicLogSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <Grid x:Name="DicLogPane" Grid.Column="2" Margin="5,0,0,0">
              <TextBox x:Name="DicLogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
            </Grid>
          </Grid>
        </Grid>

        <TextBlock Grid.Row="5" Text="DIC recovery details" Opacity="0.65" FontSize="11"/>
      </Grid>
    </TabItem>

    <TabItem x:Name="IrdTabItem">
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 M18,4 L20,4 L20,9 L18,9 Z"/><TextBlock Text="IRD" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="PS3 IRD file" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="IrdPathBox" Grid.Row="0" Grid.Column="1" Watermark="Choose the .ird describing the original PS3 disc..."/>
          <Button x:Name="IrdBrowseButton" Grid.Row="0" Grid.Column="2" Click="IrdBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Source files folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="IrdSourceFolderBox" Grid.Row="1" Grid.Column="1" Watermark="Extracted/JB PS3 game folder containing PS3_GAME, PS3_DISC.SFB, etc..."/>
          <Button x:Name="IrdSourceBrowseButton" Grid.Row="1" Grid.Column="2" Click="IrdSourceBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Output ISO" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="IrdOutputBox" Grid.Row="2" Grid.Column="1" Watermark="Plain ISO, or encrypted ISO when encryption is enabled..."/>
          <Button x:Name="IrdOutputBrowseButton" Grid.Row="2" Grid.Column="2" Click="IrdOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Disc key file" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="IrdKeyFileBox" Grid.Row="3" Grid.Column="1" Watermark="Optional .key or .txt file containing the 16-byte PS3 disc key..."/>
          <Button x:Name="IrdKeyBrowseButton" Grid.Row="3" Grid.Column="2" Click="IrdKeyBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Disc key (hex)" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox x:Name="IrdKeyTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" FontFamily="monospace" MaxLength="34" Watermark="32 hexadecimal characters; overrides the key file..."/>
        </Grid>

        <TextBlock x:Name="IrdInspectionText" Grid.Row="1" Text="No IRD loaded." Opacity="0.75" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="IrdVerifyButton" Grid.Column="0" Content="Verify source files" Click="IrdVerifyButton_Click"/>
            <Button x:Name="IrdRebuildButton" Grid.Column="1" Content="Rebuild ISO" Click="IrdRebuildButton_Click" IsEnabled="False"/>
            <Button x:Name="IrdCancelButton" Grid.Column="2" Content="Cancel" Click="IrdCancelButton_Click" IsEnabled="False"/>
            <CheckBox x:Name="IrdEncryptCheckBox" Grid.Column="3" Content="Encrypt rebuilt ISO with disc key" IsChecked="False" VerticalAlignment="Center"/>
            <Button x:Name="IrdClearSavedInputsButton" Grid.Column="5" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="IrdProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="IrdProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="180" MaxWidth="360" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="5">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="PS3 disc contents / source status" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="Activity log" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="IrdActivityLogButton" Grid.Column="2" Click="IrdActivityLogButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M12,5 C6.5,5 2.1,10 1,12 C2.1,14 6.5,19 12,19 C17.5,19 21.9,14 23,12 C21.9,10 17.5,5 12,5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z"/><TextBlock x:Name="IrdActivityLogButtonText" Text="Hide"/></StackPanel></Button>
            <Button x:Name="IrdLogDockButton" Grid.Column="3" Click="IrdLogDockButton_Click" Padding="8,4"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Width="16" Height="16" Data="M14,3 H21 V10 H19 V6.4 L11.7,13.7 L10.3,12.3 L17.6,5 H14 Z M5,5 H11 V7 H5 V19 H17 V13 H19 V19 C19,20.1 18.1,21 17,21 H5 C3.9,21 3,20.1 3,19 V7 C3,5.9 3.9,5 5,5 Z"/><TextBlock x:Name="IrdLogDockButtonText" Text="Undock"/></StackPanel></Button>
          </Grid>

          <Grid x:Name="IrdWorkspaceGrid" Grid.Row="1" ColumnDefinitions="*,6,*">
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#666666" Padding="4" Margin="0,0,5,0">
              <TreeView x:Name="IrdTree" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontFamily="monospace"/>
                      <TextBlock Text=" " FontFamily="monospace" IsVisible="{Binding !IsFolder}"/>
                      <TextBlock Text="{Binding DetailsText}" FontFamily="monospace"/>
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </Border>

            <GridSplitter x:Name="IrdLogSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <Grid x:Name="IrdLogPane" Grid.Column="2" Margin="5,0,0,0">
              <TextBox x:Name="IrdLogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
            </Grid>
          </Grid>
        </Grid>

      </Grid>
    </TabItem>

    <TabItem x:Name="OtherToolsTabItem">
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M14.5,3 C12.4,3 10.7,4.7 10.7,6.8 C10.7,7.3 10.8,7.8 11,8.2 L4,15.2 C3,16.2 3,17.8 4,18.8 C5,19.8 6.6,19.8 7.6,18.8 L14.6,11.8 C15,12 15.5,12.1 16,12.1 C18.1,12.1 19.8,10.4 19.8,8.3 C19.8,7.8 19.7,7.3 19.5,6.9 L17,9.4 L14.6,9 L14.2,6.6 L16.7,4.1 C16.1,3.4 15.3,3 14.5,3 Z"/><TextBlock Text="Other Tools" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <TabControl Margin="6" x:Name="OtherToolsTabControl">
        <TabItem Header="Concatenate">
      <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto,Auto,190" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="Source files" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
            <Button x:Name="ConcatAddButton" Content="Add files..." Click="ConcatAddButton_Click"/>
            <Button x:Name="ConcatRemoveButton" Content="Remove" Click="ConcatRemoveButton_Click"/>
            <Button x:Name="ConcatUpButton" Content="Move up" Click="ConcatUpButton_Click"/>
            <Button x:Name="ConcatDownButton" Content="Move down" Click="ConcatDownButton_Click"/>
            <Button x:Name="ConcatClearButton" Content="Clear" Click="ConcatClearButton_Click"/>
          </StackPanel>
        </Grid>

        <ListBox x:Name="ConcatFilesList" Grid.Row="1" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Spacing="5">
          <TextBlock Text="Destination filename" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="ConcatDestinationBox" Grid.Column="0" Watermark="Choose the new concatenated file..."/>
            <Button x:Name="ConcatDestinationBrowseButton" Grid.Column="1" Click="ConcatDestinationBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
          </Grid>
        </StackPanel>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,130,Auto" ColumnSpacing="8">
          <CheckBox x:Name="ConcatPaddingCheckBox" Grid.Column="0" Content="Zero padding between files" VerticalAlignment="Center"/>
          <TextBox x:Name="ConcatPaddingBytesBox" Grid.Column="1" Text="10240" Watermark="Bytes" VerticalContentAlignment="Center"/>
          <CheckBox x:Name="ConcatBoundaryCheckBox" Grid.Column="2" Content="Skip unsafe boundaries" IsChecked="True" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="ConcatStartButton" Grid.Column="0" Content="Concatenate" Click="ConcatStartButton_Click"/>
            <Button x:Name="ConcatCancelButton" Grid.Column="1" Content="Cancel" Click="ConcatCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="ConcatClearSavedInputsButton" Grid.Column="3" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="ConcatProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="ConcatProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="ConcatLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>


    <TabItem Header="HashCalc">
          <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="5">
              <TextBlock Text="File" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="HashCalcFileBox" Grid.Column="0" Watermark="Choose a file to calculate hashes for..."/>
                <Button x:Name="HashCalcBrowseButton" Grid.Column="1" Click="HashCalcBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
              </Grid>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="14">
              <TextBlock Grid.Column="0" Text="Hashes" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcCrc32CheckBox" Grid.Column="1" Content="CRC32" IsChecked="True" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcMd5CheckBox" Grid.Column="2" Content="MD5" IsChecked="True" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcSha1CheckBox" Grid.Column="3" Content="SHA-1" IsChecked="True" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcSha256CheckBox" Grid.Column="4" Content="SHA-256" IsChecked="False" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcSha384CheckBox" Grid.Column="5" Content="SHA-384" IsChecked="False" VerticalAlignment="Center"/>
              <CheckBox x:Name="HashCalcSha512CheckBox" Grid.Column="6" Content="SHA-512" IsChecked="False" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="5">
              <TextBlock Grid.Row="0" Text="Results" FontWeight="SemiBold"/>
              <TextBox x:Name="HashCalcResultsBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
            </Grid>

            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="6">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="HashCalcStartButton" Grid.Column="0" Content="Calculate" Click="HashCalcStartButton_Click"/>
                <Button x:Name="HashCalcCancelButton" Grid.Column="1" Content="Cancel" Click="HashCalcCancelButton_Click" IsEnabled="False"/>
                <Button x:Name="HashCalcClearButton" Grid.Column="2" Content="Clear results" Click="HashCalcClearButton_Click"/>
                <Button x:Name="HashCalcClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ProgressBar x:Name="HashCalcProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="HashCalcProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>


        <TabItem Header="Base64">
          <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,180,Auto,180,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="Operation" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ComboBox x:Name="Base64OperationBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Encode"/>
                <ComboBoxItem Content="Decode"/>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Input" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ComboBox x:Name="Base64InputTypeBox" Grid.Column="3" SelectedIndex="0">
                <ComboBoxItem Content="String"/>
                <ComboBoxItem Content="File"/>
              </ComboBox>
            </Grid>

            <Grid Grid.Row="1">
              <Grid x:Name="Base64TextPanel" RowDefinitions="Auto,*,Auto,*" RowSpacing="6">
                <TextBlock Grid.Row="0" Text="Input string" FontWeight="SemiBold"/>
                <TextBox x:Name="Base64InputTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="2" Text="Output string" FontWeight="SemiBold"/>
                <TextBox x:Name="Base64OutputTextBox" Grid.Row="3" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" TextAlignment="Left"/>
              </Grid>

              <StackPanel x:Name="Base64FilePanel" IsVisible="False" Spacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Input file" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="Base64InputFileBox" Grid.Column="0" Watermark="Choose a binary file to encode or a Base64 text file to decode..."/>
                    <Button x:Name="Base64InputBrowseButton" Grid.Column="1" Click="Base64InputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="Base64OutputFilePanel" Spacing="5">
                  <TextBlock Text="Output file" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="Base64OutputFileBox" Grid.Column="0" Watermark="Choose the output file..."/>
                    <Button x:Name="Base64OutputBrowseButton" Grid.Column="1" Click="Base64OutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
                  </Grid>
                </StackPanel>
              </StackPanel>

            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
              <Button x:Name="Base64ConvertButton" Grid.Column="0" Content="Convert" Click="Base64ConvertButton_Click"/>
              <Button x:Name="Base64CancelButton" Grid.Column="1" Content="Cancel" Click="Base64CancelButton_Click" IsEnabled="False"/>
              <Button x:Name="Base64ClearButton" Grid.Column="2" Content="Clear" Click="Base64ClearButton_Click"/>
              <TextBlock x:Name="Base64StatusText" Grid.Column="3" Text="Ready" VerticalAlignment="Center" TextAlignment="Right"/>
              <Button x:Name="Base64ClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
            </Grid>
          </Grid>
        </TabItem>


        <TabItem Header="Find-Ends">
          <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="165,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Partial file" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBox x:Name="FindEndsPartialBox" Grid.Column="1" Watermark="Choose the partial file..."/>
              <Button x:Name="FindEndsPartialBrowseButton" Grid.Column="2" Click="FindEndsPartialBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="165,190,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Missing side" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ComboBox x:Name="FindEndsModeBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Auto (try both)"/>
                <ComboBoxItem Content="Missing start"/>
                <ComboBoxItem Content="Missing end"/>
              </ComboBox>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="165,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Full-file target" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBox x:Name="FindEndsTargetBox" Grid.Column="1" Watermark="e.g. Track 01 ... 27807696 e6d860cb c36112ccde54f481bd52886cd31b8b01  or  27807696 e6d860cb c36112ccde54f481bd52886cd31b8b01" FontFamily="monospace"/>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="165,*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Optional source file" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBox x:Name="FindEndsSourceBox" Grid.Column="1" Watermark="Optional file to search for the missing segment..."/>
              <Button x:Name="FindEndsSourceBrowseButton" Grid.Column="2" Click="FindEndsSourceBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
              <Button x:Name="FindEndsSourceClearButton" Grid.Column="3" Content="Clear" Click="FindEndsSourceClearButton_Click"/>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="165,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Recovered output" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBox x:Name="FindEndsOutputBox" Grid.Column="1" Watermark="Written only after the reconstructed file matches the full MD5..."/>
              <Button x:Name="FindEndsOutputBrowseButton" Grid.Column="2" Click="FindEndsOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
            </Grid>

            <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="5">
              <TextBlock Grid.Row="0" Text="Result / activity" FontWeight="SemiBold"/>
              <TextBox x:Name="FindEndsLogBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextAlignment="Left"/>
            </Grid>

            <Grid Grid.Row="6" RowDefinitions="Auto,Auto" RowSpacing="6">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="FindEndsStartButton" Grid.Column="0" Content="Calculate / Search" Click="FindEndsStartButton_Click"/>
                <Button x:Name="FindEndsCancelButton" Grid.Column="1" Content="Cancel" Click="FindEndsCancelButton_Click" IsEnabled="False"/>
                <Button x:Name="FindEndsClearButton" Grid.Column="2" Content="Clear" Click="FindEndsClearButton_Click"/>
                <Button x:Name="FindEndsClearSavedInputsButton" Grid.Column="4" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ProgressBar x:Name="FindEndsProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="FindEndsProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="240" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>
      <TabItem x:Name="IsoExtractorTabItem" Header="ISO Extractor">
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Extract the primary ISO9660 filesystem directly from a 2048-byte ISO or 2352-byte BIN. Associated records and same-name records that mounted filesystems may hide are preserved in a DumpToolbox manifest-aware source folder for the DIC tab."/>

        <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Source ISO / BIN" FontWeight="SemiBold"/>
          <TextBox x:Name="IsoExtractImagePathBox" Grid.Column="1" Watermark="Choose the source ISO/BIN image..."/>
          <Button x:Name="IsoExtractImageBrowseButton" Grid.Column="2" Click="IsoExtractImageBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Output folder" FontWeight="SemiBold"/>
          <TextBox x:Name="IsoExtractOutputFolderBox" Grid.Column="1" Watermark="Folder to contain the extracted files and DumpToolbox manifest..."/>
          <Button x:Name="IsoExtractOutputBrowseButton" Grid.Column="2" Click="IsoExtractOutputBrowseButton_Click" Classes="icon-button" ToolTip.Tip="Browse…"><PathIcon Width="18" Height="18" Data="M3,5 C3,3.9 3.9,3 5,3 H9 L11,5 H19 C20.1,5 21,5.9 21,7 V8 H6.2 L3,18.5 Z M6.2,9 H22 L19,20 H3 Z"/></Button>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="IsoExtractStartButton" Grid.Column="0" Content="Extract" Padding="20,7" Click="IsoExtractStartButton_Click"/>
            <Button x:Name="IsoExtractCancelButton" Grid.Column="1" Content="Cancel" Click="IsoExtractCancelButton_Click" IsEnabled="False"/>
            <TextBlock Grid.Column="2" Text="On success, this folder is automatically set as the DIC Source Folder." Opacity="0.65" VerticalAlignment="Center"/>
            <Button x:Name="IsoExtractClearSavedInputsButton" Grid.Column="3" Click="ClearSavedInputsButton_Click" Classes="icon-button" ToolTip.Tip="Clear saved inputs"><PathIcon Width="17" Height="17" Data="M7,4 H10 L11,3 H13 L14,4 H17 V6 H7 Z M8,7 H16 L15,21 H9 Z"/></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ProgressBar x:Name="IsoExtractProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Height="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="IsoExtractProgressText" Grid.Column="1" Text="Ready" VerticalAlignment="Center" MinWidth="150" MaxWidth="260" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="5">
          <TextBlock Grid.Row="0" Text="Activity log" FontWeight="SemiBold"/>
          <TextBox x:Name="IsoExtractLogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextAlignment="Left"/>
        </Grid>
      </Grid>
    </TabItem>


    </TabControl>
    </TabItem>

    <TabItem>
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M12,3 L13,5.1 C13.7,5.3 14.3,5.5 14.9,5.9 L17.1,5.2 L18.8,6.9 L18.1,9.1 C18.5,9.7 18.7,10.3 18.9,11 L21,12 L18.9,13 C18.7,13.7 18.5,14.3 18.1,14.9 L18.8,17.1 L17.1,18.8 L14.9,18.1 C14.3,18.5 13.7,18.7 13,18.9 L12,21 L11,18.9 C10.3,18.7 9.7,18.5 9.1,18.1 L6.9,18.8 L5.2,17.1 L5.9,14.9 C5.5,14.3 5.3,13.7 5.1,13 L3,12 L5.1,11 C5.3,10.3 5.5,9.7 5.9,9.1 L5.2,6.9 L6.9,5.2 L9.1,5.9 C9.7,5.5 10.3,5.3 11,5.1 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <TabControl x:Name="SettingsTabControl" Margin="10">
        <TabItem Header="General">
          <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*" RowSpacing="18">
            <StackPanel Grid.Row="0" Spacing="8">
              <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="15"/>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <RadioButton x:Name="SettingsThemeSystemRadio" GroupName="Theme" Content="System" IsChecked="True" Checked="SettingsThemeRadio_Checked"/>
                <RadioButton x:Name="SettingsThemeDarkRadio" GroupName="Theme" Content="Dark" Checked="SettingsThemeRadio_Checked"/>
                <RadioButton x:Name="SettingsThemeLightRadio" GroupName="Theme" Content="Light" Checked="SettingsThemeRadio_Checked"/>
                <RadioButton x:Name="SettingsThemeCustomRadio" GroupName="Theme" Content="Custom" Checked="SettingsThemeRadio_Checked"/>
              </StackPanel>
              <Grid x:Name="SettingsCustomThemePanel" IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="Background" VerticalAlignment="Center"/>
                <ColorPicker x:Name="SettingsCustomBackgroundPicker" Grid.Column="1" Width="54" Color="#202020" IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="SettingsCustomColorPicker_ColorChanged"/>
                <TextBlock Grid.Column="2" Text="Text" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ColorPicker x:Name="SettingsCustomTextPicker" Grid.Column="3" Width="54" Color="#F2F2F2" IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="SettingsCustomColorPicker_ColorChanged"/>
                <TextBlock Grid.Column="4" Text="Accent" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ColorPicker x:Name="SettingsCustomAccentPicker" Grid.Column="5" Width="54" Color="#0078D4" IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="SettingsCustomColorPicker_ColorChanged"/>
                <TextBlock Grid.Column="6" Text="Input / logs" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ColorPicker x:Name="SettingsCustomInputPicker" Grid.Column="7" Width="54" Color="#2B2B2B" IsAlphaEnabled="False" IsAlphaVisible="False" ColorChanged="SettingsCustomColorPicker_ColorChanged"/>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
              <TextBlock Text="Menu layout" FontWeight="SemiBold" FontSize="15"/>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <RadioButton x:Name="SettingsMenuHorizontalRadio" GroupName="MenuLayout" Content="Horizontal tabs" IsChecked="True" Checked="SettingsMenuLayoutRadio_Checked"/>
                <RadioButton x:Name="SettingsMenuVerticalRadio" GroupName="MenuLayout" Content="Vertical tabs" Checked="SettingsMenuLayoutRadio_Checked"/>
              </StackPanel>
              <TextBlock Text="Changes the main DumpToolbox tool tabs only. Settings sub-tabs remain horizontal." TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock Text="Paths" FontWeight="SemiBold" FontSize="15"/>
              <CheckBox x:Name="SettingsRememberPathsCheckBox" Content="Remember last used paths" IsChecked="True" Click="SettingsRememberPathsCheckBox_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8">
              <TextBlock Text="Configuration maintenance" FontWeight="SemiBold" FontSize="15"/>
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="SettingsResetMainIniButton" Content="Reset DumpToolbox.ini" Padding="18,7" Margin="0,0,8,0" Click="SettingsResetMainIniButton_Click"/>
                <Button x:Name="SettingsResetEofRulesButton" Content="Reset EOFSlackRules.ini" Padding="18,7" Margin="0,0,8,0" Click="SettingsResetEofRulesButton_Click"/>
                <Button x:Name="SettingsResetJolietNamingRulesButton" Content="Reset JolietNamingRules.ini" Padding="18,7" Click="SettingsResetJolietNamingRulesButton_Click"/>
              </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
              <Button x:Name="SettingsAboutButton" Content="About..." Padding="18,7" Click="SettingsAboutButton_Click"/>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="SHA-1 Database">
          <Grid x:Name="SettingsSha1CatalogueGrid" Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,2*,Auto,*" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="6">
              <TextBlock Text="Disc collection SHA-1 catalogue" FontWeight="SemiBold" FontSize="15"/>
              <CheckBox x:Name="SettingsSha1DatabaseCheckBox" Content="Use SHA-1 catalogue in SkeleTool" IsChecked="True" Click="SettingsPreferenceChanged_Click"/>
              <TextBlock Text="The catalogue is populated here from CD/DVD image collection folders." TextWrapping="Wrap" Opacity="0.75" MaxWidth="900" HorizontalAlignment="Left"/>
              <TextBlock x:Name="SettingsSha1DatabasePathText" TextWrapping="Wrap" Opacity="0.65"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Add collection folder..." Padding="16,7" Margin="0,0,8,0" Click="SettingsSha1AddFolderButton_Click"/>
              <Button x:Name="SettingsSha1CheckAllButton" Content="Check all for changes" Padding="16,7" Margin="0,0,8,0" Click="SettingsSha1CheckAllButton_Click"/>
              <Button x:Name="SettingsSha1CancelButton" Content="Cancel scan" Padding="16,7" Margin="0,0,16,0" Click="SettingsSha1CancelButton_Click" IsEnabled="False"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,0">
                <TextBlock Text="Scan threads:" VerticalAlignment="Center"/>
                <NumericUpDown x:Name="SettingsSha1ThreadsBox" Minimum="1" Maximum="64" Increment="1" Width="120" MinWidth="120" Value="4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </StackPanel>
            </WrapPanel>

            <ProgressBar Grid.Row="2" x:Name="SettingsSha1ProgressBar" Minimum="0" Maximum="100" Height="14"/>
            <TextBlock Grid.Row="3" x:Name="SettingsSha1StatusText" Text="No scan running." TextWrapping="Wrap" Opacity="0.75"/>

            <TextBlock Grid.Row="4" Text="Registered collection folders" FontWeight="SemiBold"/>
            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="150">
              <StackPanel x:Name="SettingsSha1RootsPanel" Spacing="6"/>
            </ScrollViewer>

            <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="Scan activity log" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="SettingsSha1LogUndockButton" Content="Undock" Padding="12,5" Margin="0,0,8,0" Click="SettingsSha1LogUndockButton_Click"/>
              <Button Grid.Column="2" Content="Clear" Padding="12,5" Click="SettingsSha1LogClearButton_Click"/>
            </Grid>
            <TextBox Grid.Row="7" x:Name="SettingsSha1LogTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" MinHeight="130"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </TabItem>

        <TabItem Header="Heads and Tails">
          <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,2*,Auto,*" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="6">
              <TextBlock Text="Audio Heads and Tails catalogue" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="Scans loose CUEs and supported archives, then stores the first and last non-zero 256 bytes of every AUDIO track. Archives are processed in-place where possible; full extraction is avoided. Completely zero-filled tracks are recorded but add no bytes to the corpus." TextWrapping="Wrap" Opacity="0.75" MaxWidth="900" HorizontalAlignment="Left"/>
              <TextBlock x:Name="SettingsHeadsTailsDatabasePathText" TextWrapping="Wrap" Opacity="0.65"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Corpus file:" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" x:Name="SettingsHeadsTailsCorpusPathTextBox" Watermark="Choose where AudioHeadsandTails.bin should be written"/>
              <Button Grid.Column="2" Content="Browse..." Padding="14,6" Click="SettingsHeadsTailsCorpusBrowseButton_Click"/>
            </Grid>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="Add collection folder..." Padding="16,7" Margin="0,0,8,0" Click="SettingsHeadsTailsAddFolderButton_Click"/>
              <Button x:Name="SettingsHeadsTailsCheckAllButton" Content="Check all for changes" Padding="16,7" Margin="0,0,8,0" Click="SettingsHeadsTailsCheckAllButton_Click"/>
              <Button x:Name="SettingsHeadsTailsCancelButton" Content="Cancel scan" Padding="16,7" Margin="0,0,16,0" Click="SettingsHeadsTailsCancelButton_Click" IsEnabled="False"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Scan threads:" VerticalAlignment="Center"/>
                <NumericUpDown x:Name="SettingsHeadsTailsThreadsBox" Minimum="1" Maximum="64" Increment="1" Width="120" MinWidth="120" Value="4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </StackPanel>
            </WrapPanel>
            <ProgressBar Grid.Row="3" x:Name="SettingsHeadsTailsProgressBar" Minimum="0" Maximum="100" Height="14"/>
            <TextBlock Grid.Row="4" x:Name="SettingsHeadsTailsStatusText" Text="No scan running." TextWrapping="Wrap" Opacity="0.75"/>
            <TextBlock Grid.Row="5" Text="Registered collection folders" FontWeight="SemiBold"/>
            <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="150"><StackPanel x:Name="SettingsHeadsTailsRootsPanel" Spacing="6"/></ScrollViewer>
            <Grid Grid.Row="7" ColumnDefinitions="*,Auto"><TextBlock Text="Scan activity log" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Clear" Padding="12,5" Click="SettingsHeadsTailsLogClearButton_Click"/></Grid>
            <TextBox Grid.Row="8" x:Name="SettingsHeadsTailsLogTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" MinHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </TabItem>
      </TabControl>
    </TabItem>
    <TabItem x:Name="DevEvidenceTabItem" IsVisible="False">
      <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="M5,4 C5,2.9 8.1,2 12,2 C15.9,2 19,2.9 19,4 V8 C19,9.1 15.9,10 12,10 C8.1,10 5,9.1 5,8 Z M5,10 C6.5,11.2 9.2,12 12,12 C14.8,12 17.5,11.2 19,10 V14 C19,15.1 15.9,16 12,16 C8.1,16 5,15.1 5,14 Z M5,16 C6.5,17.2 9.2,18 12,18 C14.8,18 17.5,17.2 19,16 V20 C19,21.1 15.9,22 12,22 C8.1,22 5,21.1 5,20 Z"/><TextBlock Text="Disc Evidence" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
      <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,180" RowSpacing="8">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Disc mastering evidence (developer tool)" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock Text="Uses the SHA-1 catalogue as its work queue. Collects ISO9660/Joliet naming and EOF-slack evidence from CD images and filesystem/mastering evidence from DVD images into a separate database." TextWrapping="Wrap" Opacity="0.75"/>
          <TextBlock x:Name="DevEvidenceDatabaseText" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="DevEvidenceScanButton" Content="Gather pending evidence" Padding="16,7" Margin="0,0,8,0" Click="DevEvidenceScanButton_Click"/>
          <Button x:Name="DevEvidenceCancelButton" Content="Cancel" Padding="16,7" Margin="0,0,8,0" IsEnabled="False" Click="DevEvidenceCancelButton_Click"/>
          <Button x:Name="DevEvidenceAnalyseButton" Content="Export analysis CSVs" Padding="16,7" Margin="0,0,8,0" Click="DevEvidenceAnalyseButton_Click"/>
          <Button x:Name="DevEvidenceResetButton" Content="Mark all pending" Padding="16,7" Margin="0,0,18,0" Click="DevEvidenceResetButton_Click"/>
          <TextBlock Text="Threads:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <NumericUpDown x:Name="DevEvidenceThreadsBox" Minimum="1" Maximum="64" Increment="1" Width="100" Value="4"/>
        </WrapPanel>
        <ProgressBar Grid.Row="2" x:Name="DevEvidenceProgressBar" Minimum="0" Maximum="100" Height="14"/>
        <TextBlock Grid.Row="3" x:Name="DevEvidenceStatusText" Text="Ready" TextWrapping="Wrap" Opacity="0.8"/>
        <StackPanel Grid.Row="4" Spacing="5">
          <TextBlock Text="Scope" FontWeight="SemiBold"/>
          <TextBlock Text="CD: ISO9660 + Joliet directory evidence, Oracle/mastering volume fields, EOF slack and earlier-sector candidate deltas. DVD: retained in the corpus and classified as DVD; ISO9660/Joliet evidence is collected when present and UDF presence is recorded. No VIDEO_TS-specific logic is used." TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
          <TextBlock Text="Activity log" FontWeight="SemiBold"/>
          <Button Grid.Column="1" Content="Clear" Padding="12,5" Click="DevEvidenceClearLogButton_Click"/>
        </Grid>
        <TextBox Grid.Row="6" x:Name="DevEvidenceLogTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </Grid>
    </TabItem>

  </TabControl>
</Window>
